# Variables de entorno de producción (Vercel). Reconstruidas a partir de las
# referencias en el código — no se pudo recuperar el .env.example original
# (Vercel bloquea la previsualización de archivos .env).

# Acceso con contraseña única (opcional). Sin estas dos, la app queda abierta
# sin pedir nada (uso local).
APP_PASSWORD=
AUTH_SECRET=

# Microsoft Entra ID / Graph — mismo tenant y app registration para CAPEX y OPEX.
SP_TENANT_ID=
SP_CLIENT_ID=
SP_CLIENT_SECRET=

# Archivo de SharePoint para CAPEX.
SP_CAPEX_SHARE_URL=
SP_CAPEX_HOJA=BD_CAPEX
SP_CAPEX_HOJA_PROYECCION=Proyeccion 2026_vm

# Archivo de SharePoint para OPEX.
SP_OPEX_SHARE_URL=
SP_OPEX_HOJA_PRESUPUESTO=Presupuesto 2026
SP_OPEX_HOJA_FACTURAS=Facturas Opex - App

# Año de presupuesto que la app muestra en títulos y menús (Dashboard, Planificación,
# etc.). CAMBIAR ESTO ES TODO LO QUE HACE FALTA PARA PASAR DE AÑO (ej. de 2026 a 2027) —
# solo edítala en Azure (App Settings del App Service) y reinicia la app; no requiere
# tocar código ni volver a desplegar. Si el Excel real usa una hoja distinta cada año
# (ej. "Presupuesto 2026" -> "Presupuesto 2027"), actualiza también SP_OPEX_HOJA_PRESUPUESTO
# y SP_CAPEX_HOJA_PROYECCION arriba — también son solo variables de entorno.
ANIO_PRESUPUESTO=2026
